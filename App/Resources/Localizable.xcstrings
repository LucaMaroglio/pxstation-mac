      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfono"
          }
        }
      }
    },
    "Microphone allowed; sent only while the virtual machine records.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfono consentito; viene inviato solo mentre la macchina virtuale registra."
          }
        }
      }
    },
    "Microphone Off": {
      "localizations": {
        "it": {
