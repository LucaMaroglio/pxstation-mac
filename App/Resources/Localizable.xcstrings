    "The ticket in the connection file can only be used once. Open a new connection file to reconnect.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ticket del file di connessione si può usare una sola volta. Apri un nuovo file di connessione per riconnetterti."
          }
        }
      }
    },
    "The ticket in the connection file is too long.": {
