          }
        }
      }
    },
    "The server’s certificate isn’t trusted by macOS or by a Proxmox CA this app has seen.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il certificato del server non è considerato attendibile né da macOS né da una CA Proxmox già vista da questa app."
          }
        }
      }
    },
    "The session ended unexpectedly (%@).": {
      "comment": "Error message from SpiceKit (String(localized:bundle: .main))",
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione è terminata in modo imprevisto (%@)."
          }
