      }
    },
    "The proxy rejected the connection (HTTP %lld). With Proxmox this usually means the connection file has expired: click SPICE again and open the new file right away.": {
      "comment": "Error message from SpiceKit (String(localized:bundle: .main))",
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
