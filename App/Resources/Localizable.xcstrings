    "Add": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi"
          }
        }
      }
    },
    "Add a Proxmox server with an API token to start, stop and connect to virtual machines from here.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un server Proxmox con un token API per avviare, arrestare e connetterti alle macchine virtuali da qui."
          }
        }
      }
    },
    "Add Server…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi server…"
          }
        }
      }
    },
    "Allow the virtual machine to use your microphone": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti alla macchina virtuale di usare il microfono"
          }
        }
      }
    },
    "Appears in the VM as a USB smartcard reader (uses one USB slot).": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare nella VM come lettore di smartcard USB (usa uno slot USB)."
          }
        }
      }
    },
    "Applies to new sessions. The microphone is off in every session until you switch it on in the toolbar.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per le nuove sessioni. Il microfono è disattivato in ogni sessione finché non lo attivi dalla barra strumenti."
          }
        }
      }
    },
