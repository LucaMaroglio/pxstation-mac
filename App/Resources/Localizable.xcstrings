    },
    "The virtual machine is hearing your microphone. Click to turn it off.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La macchina virtuale sta ricevendo il tuo microfono. Fai clic per disattivarlo."
          }
        }
      }
    },
    "The virtual machine is migrating to another host.": {
